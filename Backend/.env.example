# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Supported DB_TYPE options: 'sqlite' | 'postgres'
DB_TYPE=sqlite

# SQLite Options (used when DB_TYPE=sqlite)
DB_SQLITE_PATH=clubcurator.sqlite

# PostgreSQL Options (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=clubcurator_db

# TypeORM Options
DB_SYNCHRONIZE=true
DB_LOGGING=true
