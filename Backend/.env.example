# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Supported DB_TYPE options: 'sqlite' | 'postgres'
DB_TYPE=sqlite

# SQLite Options (used when DB_TYPE=sqlite)
DB_SQLITE_PATH=clubcurator.sqlite

# PostgreSQL Options (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=clubcurator_db

# TypeORM Options
DB_SYNCHRONIZE=true
DB_LOGGING=true

# SOAP Inventory Service
SOAP_INVENTARIO_ENABLED=true
SOAP_INVENTARIO_URL=http://localhost:3000/soap/inventario
SOAP_TIMEOUT_MS=5000

# JWT Auth Configuration
JWT_SECRET=clubcurator-secret-access-token-key-2026
JWT_REFRESH_SECRET=clubcurator-secret-refresh-token-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Colas (worker de solicitudes de suscripción; deshabilitado hasta validar) ---
# RABBITMQ_URL=amqp://clubcurator:change-me-local-only@localhost:5672
# RABBITMQ_EXCHANGE=subscription.requests
# RABBITMQ_QUEUE=subscription.requests
# RABBITMQ_ROUTING_KEY=subscription.requested
# RABBITMQ_CONNECT_ATTEMPTS=5
# RABBITMQ_RECONNECT_DELAY_MS=1000
# OUTBOX_POLL_INTERVAL_MS=50    # menor = menos latencia, más consultas en reposo (mín. 10)
# OUTBOX_BATCH_SIZE=50
# RABBITMQ_PREFETCH=20
# Habilitar SOLO tras validar con RabbitMQ/PostgreSQL reales (ver docs/runbook-colas-suscripciones.md):
# QUEUE_RUNTIME_ENABLED=true              # proceso worker (npm run worker)
# SUBSCRIPTION_REQUESTS_ENABLED=true      # monta POST/GET /api/solicitudes-suscripcion en la API

# --- Pagos recurrentes (patrón Strategy; requieren la cola habilitada) ---
# PAYMENT_PROVIDER=none          # none (alta sin cobro) | fake (demo/tests, sin red) | stripe
# Los precios de las cajas están en PAYMENT_BASE_CURRENCY (pesos). El proveedor cobra en PAYMENT_CURRENCY al tipo de cambio fijo
# PAYMENT_FX_RATE (unidades de moneda base por 1 unidad de moneda de cobro: 1200 = 1200 ARS por 1 USD). Obligatorio si difieren.
# PAYMENT_BASE_CURRENCY=ARS
# PAYMENT_CURRENCY=USD
# PAYMENT_FX_RATE=1500
# PAYMENT_CHECKOUT_TTL_MINUTES=30         # vigencia del checkout (Stripe: entre 30 min y 24 h)
# PAYMENT_PORTAL_RETURN_URL=http://localhost:5173/catalogo
# PAYMENT_SUCCESS_URL=http://localhost:5173/catalogo?pago=exito
# PAYMENT_CANCEL_URL=http://localhost:5173/catalogo?pago=cancelado
# STRIPE_SECRET_KEY=sk_test_...             # clave de TEST de Stripe
# STRIPE_WEBHOOK_SECRET=whsec_...           # lo imprime `stripe listen --forward-to localhost:3000/api/webhooks/payments`
# FAKE_PAYMENT_WEBHOOK_SECRET=fake-webhook-secret

# --- Recomendador con IA (DeepSeek) ---
# Podés omitir DEEPSEEK_API_KEY y enviar "apiKey" en la solicitud POST /api/cajas-mensuales/recomendar (solo para pruebas).
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com
