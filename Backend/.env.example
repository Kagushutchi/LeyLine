# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# Supported DB_TYPE options: 'sqlite' | 'postgres'
DB_TYPE=sqlite

# SQLite Options (used when DB_TYPE=sqlite)
DB_SQLITE_PATH=clubcurator.sqlite

# PostgreSQL Options (used when DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=clubcurator_db

# TypeORM Options
DB_SYNCHRONIZE=true
DB_LOGGING=true

# SOAP Inventory Service
SOAP_INVENTARIO_ENABLED=true
SOAP_INVENTARIO_URL=http://localhost:3000/soap/inventario
SOAP_TIMEOUT_MS=5000

# JWT Auth Configuration
JWT_SECRET=clubcurator-secret-access-token-key-2026
JWT_REFRESH_SECRET=clubcurator-secret-refresh-token-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
